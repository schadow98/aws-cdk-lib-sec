{
    "name": "aws-cdk-lib-sec",
    "version": "1.0.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && npm run copy-default-stack",
        "copy-default-stack": "node -e \"require('fs').cpSync('src/aws-default-stacks', 'dist/aws-default-stacks', { recursive: true })\"",
        "prepare": "npm run build",
        "auto": "nodemon --exec ts-node app.ts",
        "dev": "ts-node app.ts",
        "start": "node app.js",
        "test": "jest",
        "coverage": "jest --coverage",
        "linting": "npx eslint ./src"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.7.2",
        "eslint": "^9.22.0",
        "globals": "^15.13.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.7",
        "ts-jest": "^29.2.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1"
    },
    "dependencies": {
        "@aws-sdk/client-cloudformation": "^3.665.0",
        "@types/json-diff": "^1.0.3",
        "aws-cdk": "^2.160.0",
        "aws-cdk-lib": "^2.160.0",
        "aws-sdk": "^2.1692.0",
        "commander": "^12.1.0",
        "deep-diff": "^1.0.2",
        "json-diff": "^1.0.6",
        "jsonwebtoken": "^9.0.2",
        "snyk": "^1.1294.2",
        "winston": "^3.14.2"
    },
    "keywords": [
        "aws",
        "cdk",
        "security",
        "typescript"
    ],
    "license": "MIT",
    "private": false
}
