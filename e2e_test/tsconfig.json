{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",           // ← wichtig
    "lib": ["es2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "moduleResolution": "node"
  },
  "include": ["./**/*"]
}
